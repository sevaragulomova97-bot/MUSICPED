# MusicPed — muhit o'zgaruvchilari
#
# Loyihada maxfiy kalit, parol yoki API tokeni YO'Q va bo'lmaydi ham:
# platforma serversiz, barcha ma'lumot foydalanuvchining brauzerida
# qoladi. Shuning uchun bu faylda faqat bitta yo'l sozlamasi bor.
#
# Haqiqiy `.env` fayli git ga kiritilmaydi.

# Sayt ildizdan emas, ichki yo'ldan xizmat qilsa (GitHub Pages'da
# `https://<foydalanuvchi>.github.io/<ombor>/`) shu yerga `/<ombor>`
# yoziladi. GitHub Actions uni `actions/configure-pages` natijasidan
# avtomatik qo'yadi, shuning uchun odatda qo'lda sozlash shart emas.
#
# Mahalliy ishlab chiqishda bo'sh qoldiriladi.
NEXT_PUBLIC_BASE_PATH=

# ─────────────────────────────────────────────────────────────
# Yig'uvchi server (ixtiyoriy)
#
# Bu ikki qiymat qo'yilsa, talabada «O'qituvchiga yuborish» tugmasi
# paydo bo'ladi va natijalar fayl almashtirmasdan o'qituvchiga
# boradi. Bo'sh qoldirilsa — platforma hozirgidek, faqat fayl
# orqali ishlaydi va tugma umuman ko'rinmaydi.
#
# Bu yerdagi kalit MAXFIY EMAS: u brauzerga tushadi va uni har kim
# ko'ra oladi. Shuning uchun u faqat **yozish** huquqiga ega
# bo'lishi kerak (Supabase'da RLS siyosati bilan). O'qish kaliti
# kodga hech qachon yozilmaydi — o'qituvchi uni o'z brauzeriga
# kiritadi.
#
# Sozlash qadamlari: docs/SERVER.md
NEXT_PUBLIC_YIGUVCHI_URL=
NEXT_PUBLIC_YIGUVCHI_KALIT=
